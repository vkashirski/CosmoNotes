{
  "name": "cosmonotes",
  "productName": "CosmoNotes",
  "version": "1.1.23",
  "description": "Cute sticky notes that stay on your computer.",
  "author": "Vasil",
  "license": "MIT",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis --x64",
    "test": "node tests/run.js"
  },
  "dependencies": {
    "@fontsource/caveat": "^5.0.0",
    "@fontsource/nunito": "^5.0.0"
  },
  "devDependencies": {
    "electron": "^39.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "com.stickypins.app",
    "productName": "CosmoNotes",
    "copyright": "CosmoNotes",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "store.js",
      "preload.js",
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "runAfterFinish": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "CosmoNotes",
      "deleteAppDataOnUninstall": false,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "artifactName": "CosmoNotes Setup ${version}.${ext}",
      "include": "build/installer.nsh"
    },
    "disableAsarIntegrity": true,
    "extraResources": [
      {
        "from": "build/icon.ico",
        "to": "icon.ico"
      }
    ]
  }
}
